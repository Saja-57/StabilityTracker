# Therapist web: safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Parent mobile: embedded in the application bundle. Use only public values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Ask AI endpoint; defaults to http://<Metro host>:3000/api/ask in development.
EXPO_PUBLIC_ASK_AI_URL=

# Server-only values. Never reference these from browser or mobile modules.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional. Model for Ask AI (default: gpt-5-mini).
OPENAI_MODEL=
